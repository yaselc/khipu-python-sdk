# http://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.css]
indent_style = space
indent_size = 2

[*.ini]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2

[{*.mk,Makefile}]
indent_style = tab

[*.py]
indent_style = space
indent_size = 4

[*.sh]
indent_style = tab

[*.toml]
indent_style = space
indent_size = 2

[*.{yaml,yaml.*,yml,yml.*}]
indent_style = space
indent_size = 2
